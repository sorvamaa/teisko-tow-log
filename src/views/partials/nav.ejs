<%
  const path = typeof currentPath === 'string' ? currentPath : '';
  const on = (...prefixes) => prefixes.some(p => path === p || path.startsWith(p + '/')) ? ' active' : '';
  const groups = [
    { label: 'Maksut', items: [
      { href: '/admin/balances', text: 'Maksutilanne' },
      { href: '/admin/payments', text: 'Kirjaa maksu / historia' },
      { href: '/admin/expenses', text: 'Kulut' }
    ] },
    { label: 'Raportit', items: [
      { href: '/admin/seasons/current/report', text: 'Kausiraportti', match: /^\/admin\/seasons\/[^/]+\/report$/ },
      { href: '/admin/summary/tows', text: 'Hinaukset aikaväliltä' }
    ] },
    { label: 'Asetukset', items: [
      { href: '/admin/pilots', text: 'Pilotit' },
      { href: '/admin/vehicles', text: 'Ajoneuvot' },
      { href: '/admin/seasons', text: 'Kaudet', exclude: /\/report$/ },
      { href: '/admin/users', text: 'Käyttäjät' }
    ] }
  ];
  const itemActive = it => it.match ? it.match.test(path)
    : ((path === it.href || path.startsWith(it.href + '/')) && !(it.exclude && it.exclude.test(path)));
%>
<nav class="navbar">
  <a href="/" class="nav-brand">Teisko Tow Log</a>
  <% if (user) { %>
    <button class="nav-toggle" type="button" aria-label="Valikko" aria-expanded="false">&#9776;</button>
    <div class="nav-links">
      <% if (user.role === 'admin') { %>
        <a href="/flight-days" class="nav-top<%= on('/flight-days') %>">Lentopäivät</a>
        <% groups.forEach(g => { const active = g.items.some(itemActive); %>
          <div class="nav-group<%= active ? ' active' : '' %>">
            <button type="button" class="nav-group-label" aria-haspopup="true" aria-expanded="false"><%= g.label %> <span class="nav-caret">&#9662;</span></button>
            <div class="nav-menu">
              <% g.items.forEach(it => { %>
                <a href="<%= it.href %>"<%- itemActive(it) ? ' class="active" aria-current="page"' : '' %>><%= it.text %></a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } %>
      <div class="nav-group nav-user-group<%= on('/auth/change-password') %>">
        <button type="button" class="nav-group-label" aria-haspopup="true" aria-expanded="false"><%= user.name %> <span class="nav-caret">&#9662;</span></button>
        <div class="nav-menu nav-menu-right">
          <a href="/auth/change-password">Vaihda salasana</a>
          <form method="POST" action="/auth/logout" class="nav-logout">
            <button type="submit">Kirjaudu ulos</button>
          </form>
        </div>
      </div>
    </div>
  <% } %>
</nav>
