<%- include('../partials/header') %>

<div class="auth-page">
  <h1>Vaihda salasana</h1>

  <% if (forced) { %>
    <div class="alert alert-info">
      Sinun tulee vaihtaa salasanasi ennen kuin voit jatkaa.
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
    <p style="margin-top: 1rem"><a href="/" class="btn btn-primary">Etusivulle</a></p>
  <% } else { %>
    <form method="POST" action="/auth/change-password" class="form">
      <div class="form-group">
        <label for="current_password">Nykyinen salasana</label>
        <input type="password" id="current_password" name="current_password" required autofocus>
      </div>
      <div class="form-group">
        <label for="new_password">Uusi salasana (vähintään 8 merkkiä)</label>
        <input type="password" id="new_password" name="new_password" minlength="8" required>
      </div>
      <div class="form-group">
        <label for="new_password_confirm">Uusi salasana uudelleen</label>
        <input type="password" id="new_password_confirm" name="new_password_confirm" minlength="8" required>
      </div>
      <button type="submit" class="btn btn-primary">Vaihda salasana</button>
    </form>
  <% } %>
</div>

<%- include('../partials/footer') %>
