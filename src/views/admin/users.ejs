<%- include('../partials/header') %>

<div class="page">
  <h1>Käyttäjät</h1>

  <% if (errors) { %>
    <div class="alert alert-error"><% errors.forEach(e => { %><p><%= e.msg %></p><% }) %></div>
  <% } %>

  <div class="card" style="margin-bottom: 1.5rem">
    <h2>Luo käyttäjä</h2>
    <form method="POST" action="/admin/users" class="form">
      <div class="form-row">
        <div class="form-group">
          <label for="name">Nimi</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-group">
          <label for="email">Sähköposti</label>
          <input type="email" id="email" name="email" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="password">Salasana</label>
          <input type="password" id="password" name="password" minlength="6" required>
        </div>
        <div class="form-group">
          <label for="role">Rooli</label>
          <select id="role" name="role">
            <option value="user">Käyttäjä</option>
            <option value="admin">Ylläpitäjä</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Luo käyttäjä</button>
    </form>
  </div>

  <div class="table-wrap">
    <table>
      <thead><tr><th>Nimi</th><th>Sähköposti</th><th>Rooli</th><th>Toiminnot</th></tr></thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <form method="POST" action="/admin/users/<%= u.id %>">
              <td><input type="text" name="name" value="<%= u.name %>" class="input-table" required></td>
              <td><%= u.email %></td>
              <td>
                <select name="role" class="input-table">
                  <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Käyttäjä</option>
                  <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Ylläpitäjä</option>
                </select>
              </td>
              <td><button type="submit" class="btn btn-small">Tallenna</button></td>
            </form>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
