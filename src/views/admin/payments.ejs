<%- include('../partials/header') %>

<% const typeLabel = { daily: 'Päivämaksu', season: 'Kausikortti', per_tow: 'Hinausmaksu (per hinaus)' }; %>

<div class="page">
  <%- include('../partials/payment-tabs') %>
  <div class="page-header">
    <h1>Hinausmaksut</h1>
  </div>

  <% if (errors) { %>
    <div class="alert alert-error"><% errors.forEach(e => { %><p><%= e.msg %></p><% }) %></div>
  <% } %>

  <div class="card" style="margin-bottom: 1.5rem">
    <h2>Kirjaa maksu</h2>
    <form method="POST" action="/admin/payments" class="form">
      <div class="form-row">
        <div class="form-group">
          <label for="pilot_id">Pilotti</label>
          <select id="pilot_id" name="pilot_id" required>
            <option value="">Valitse...</option>
            <% pilots.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %><%= p.billing_type === 'per_tow' ? ' (per hinaus)' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="season_id">Kausi</label>
          <select id="season_id" name="season_id" required>
            <% seasons.forEach(s => { %>
              <option value="<%= s.id %>" <%= openSeason && s.id === openSeason.id ? 'selected' : '' %>><%= s.name %><%= s.end_date ? ' (suljettu)' : '' %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="type">Tyyppi</label>
          <select id="type" name="type" required>
            <option value="daily">Päivämaksu<%= openSeason ? ' (' + eur(parseFloat(openSeason.price_daily)) + ')' : '' %></option>
            <option value="season">Kausikortti<%= openSeason ? ' (' + eur(parseFloat(openSeason.price_season)) + ')' : '' %></option>
            <option value="per_tow">Hinausmaksu (per hinaus, summa käsin)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="amount">Summa (€) <span class="text-muted">– vain hinausmaksuille</span></label>
          <input type="text" inputmode="decimal" id="amount" name="amount" placeholder="esim. 245">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="payment_method">Maksutapa</label>
          <select id="payment_method" name="payment_method" required>
            <option value="MobilePay">MobilePay</option>
            <option value="Käteinen">Käteinen</option>
            <option value="Tilisiirto">Tilisiirto</option>
          </select>
        </div>
        <div class="form-group">
          <label for="date">Päivämäärä</label>
          <input type="date" id="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
      </div>
      <div class="form-group">
        <label for="note">Huomautus</label>
        <input type="text" id="note" name="note">
      </div>
      <p class="text-muted">Päivämaksun ja kausikortin summa tulee valitun kauden hinnoista.</p>
      <button type="submit" class="btn btn-primary">Kirjaa maksu</button>
    </form>
  </div>

  <h2>Maksuhistoria</h2>
  <p class="text-muted">Muokkaa kenttää ja paina Tallenna. Poista poistaa maksun lopullisesti.</p>
  <% if (payments.length === 0) { %>
    <p class="empty-state">Ei maksuja.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Pvm</th><th>Pilotti</th><th>Kausi</th><th>Tyyppi</th><th>Summa</th><th>Maksutapa</th><th>Huomautus</th><th>Toiminnot</th></tr></thead>
        <tbody>
          <% payments.forEach(p => { %>
            <tr>
              <td><input type="date" name="date" form="payment-<%= p.id %>" value="<%= p.date_str %>" class="input-table" required></td>
              <td>
                <select name="pilot_id" form="payment-<%= p.id %>" class="input-table" required>
                  <% allPilots.forEach(pi => { %>
                    <option value="<%= pi.id %>" <%= pi.id === p.pilot_id ? 'selected' : '' %>><%= pi.name %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <select name="season_id" form="payment-<%= p.id %>" class="input-table" required>
                  <% seasons.forEach(s => { %>
                    <option value="<%= s.id %>" <%= s.id === p.season_id ? 'selected' : '' %>><%= s.name %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <select name="type" form="payment-<%= p.id %>" class="input-table" required>
                  <% ['daily', 'season', 'per_tow'].forEach(t => { %>
                    <option value="<%= t %>" <%= p.type === t ? 'selected' : '' %>><%= typeLabel[t] %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <% if (p.type === 'per_tow') { %>
                  <input type="text" inputmode="decimal" name="amount" form="payment-<%= p.id %>" value="<%= parseFloat(p.amount) %>" class="input-table input-small">
                <% } else { %>
                  <%= eur(parseFloat(p.amount)) %>
                  <input type="hidden" name="amount" form="payment-<%= p.id %>" value="<%= parseFloat(p.amount) %>">
                <% } %>
              </td>
              <td>
                <select name="payment_method" form="payment-<%= p.id %>" class="input-table" required>
                  <% ['MobilePay', 'Käteinen', 'Tilisiirto'].forEach(m => { %>
                    <option value="<%= m %>" <%= p.payment_method === m ? 'selected' : '' %>><%= m %></option>
                  <% }) %>
                  <% if (!['MobilePay', 'Käteinen', 'Tilisiirto'].includes(p.payment_method)) { %>
                    <option value="<%= p.payment_method %>" selected><%= p.payment_method %></option>
                  <% } %>
                </select>
              </td>
              <td><input type="text" name="note" form="payment-<%= p.id %>" value="<%= p.note || '' %>" class="input-table"></td>
              <td>
                <div class="btn-group">
                  <button type="submit" form="payment-<%= p.id %>" class="btn btn-small">Tallenna</button>
                  <button type="submit" form="payment-delete-<%= p.id %>" class="btn btn-small btn-danger">Poista</button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% payments.forEach(p => { %>
      <form id="payment-<%= p.id %>" method="POST" action="/admin/payments/<%= p.id %>"></form>
      <form id="payment-delete-<%= p.id %>" method="POST" action="/admin/payments/<%= p.id %>/delete"
            data-confirm="Poistetaanko maksu: <%= p.pilot_name %>, <%= typeLabel[p.type].toLowerCase() %> <%= eur(parseFloat(p.amount)) %>? Tätä ei voi perua."></form>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
